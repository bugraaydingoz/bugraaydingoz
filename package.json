{
  "name": "bugraaydingoz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "dev:bugraaydingoz": "pnpm --filter bugraaydingoz-web dev",
    "dev:myanaesthesie": "pnpm --filter myanaesthesie-web dev",
    "dev:robofleet": "pnpm db:up && pnpm --filter robofleet-api db:migrate && pnpm --parallel --filter 'robofleet-*' dev",
    "db:compose": "docker compose --project-name bugraaydingoz-dev --env-file .env.local -f infra/docker-compose.yml -f infra/docker-compose.dev.yml",
    "db:up": "pnpm db:compose up -d --wait --wait-timeout 90 postgres",
    "redis:up": "pnpm db:compose up -d --wait --wait-timeout 90 redis",
    "test:messaging": "pnpm redis:up && pnpm --filter @repo/messaging test:integration",
    "db:test:robofleet": "pnpm db:up && pnpm --filter robofleet-api test:db",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
