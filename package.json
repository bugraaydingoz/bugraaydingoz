{
  "name": "bugraaydingoz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "dev:bugraaydingoz": "pnpm --filter bugraaydingoz-web dev",
    "dev:myanaesthesie": "pnpm --filter myanaesthesie-web dev",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
