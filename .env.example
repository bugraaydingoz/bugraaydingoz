# Production: copy to .env. Development: copy to .env.local.
# Set a randomly generated password (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Optional development-only host port. Production does not publish Postgres.
POSTGRES_PORT=5432

# Shared Redis for background jobs. Use a separate random password.
REDIS_PASSWORD=

# Optional development-only host port. Production does not publish Redis.
REDIS_PORT=6379
