---
import { articles } from "../../data/articles";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
    return articles.map((article) => ({
        params: { slug: article.slug },
        props: { article },
    }));
}

const { article } = Astro.props;

const iconClasses = {
    arrowLeft: "ph ph-arrow-left",
    caretDown: "ph ph-caret-down",
    cloud: "ph ph-cloud",
    doc: "ph ph-file-text",
    dots: "ph ph-dots-three-vertical",
    globe: "ph ph-globe",
    image: "ph ph-image",
    link: "ph ph-link",
    listBullets: "ph ph-list-bullets",
    minus: "ph ph-minus",
    paintRoller: "ph ph-paint-roller",
    pencil: "ph ph-pencil-simple",
    plus: "ph ph-plus",
    printer: "ph ph-printer",
    redo: "ph ph-arrow-clockwise",
    search: "ph ph-magnifying-glass",
    star: "ph ph-star",
    tab: "ph ph-sidebar-simple",
    textAlignLeft: "ph ph-text-align-left",
    underline: "ph ph-text-underline",
    undo: "ph ph-arrow-counter-clockwise",
};

const menuGroups = [
    ["File", ["New", "Open", "Make a copy", "Download"]],
    ["Edit", ["Undo", "Redo", "Cut", "Paste"]],
    ["View", ["Print layout", "Show ruler", "Document tabs"]],
    ["Insert", ["Image", "Table", "Comment", "Link"]],
    ["Format", ["Text", "Alignment", "Line spacing"]],
    ["Tools", ["Spelling", "Word count", "Preferences"]],
    ["Extensions", ["Add-ons", "Apps Script"]],
    ["Help", ["Docs help", "Keyboard shortcuts"]],
];

const toolbarIcons = [
    ["Search menus", iconClasses.search],
    ["Undo", iconClasses.undo],
    ["Redo", iconClasses.redo],
    ["Print", iconClasses.printer],
    ["Paint format", iconClasses.paintRoller],
];
---

<Layout>
    <main class="docs-shell" aria-label={`${article.title} article draft`}>
        <header class="docs-topbar">
            <section class="title-cluster" aria-label="Document title">
                <a class="docs-logo" href="/" aria-label="Back to home">
                    <i class={iconClasses.doc} aria-hidden="true"></i>
                </a>
                <div class="title-stack">
                    <div class="title-row">
                        <span class="doc-title">{article.title}</span>
                        <i
                            class={`${iconClasses.star} subtle`}
                            aria-hidden="true"
                        ></i>
                        <i
                            class={`${iconClasses.cloud} subtle`}
                            aria-hidden="true"
                        ></i>
                    </div>
                    <nav class="menu-bar" aria-label="Mock document menu">
                        {
                            menuGroups.map(([label, items]) => (
                                <details class="menu-item">
                                    <summary>{label}</summary>
                                    <div class="menu-panel">
                                        {(items as string[]).map((item) => (
                                            <button type="button">{item}</button>
                                        ))}
                                    </div>
                                </details>
                            ))
                        }
                    </nav>
                </div>
            </section>

            <section class="top-actions" aria-label="Sharing controls">
                <button class="request-access" type="button">
                    Request edit access
                </button>
                <span class="avatar" aria-label="Buğra Aydıngöz">B</span>
                <button class="share-action" type="button">
                    <i class={iconClasses.globe} aria-hidden="true"></i>
                    <span>Share</span>
                    <i
                        class={`${iconClasses.caretDown} tiny`}
                        aria-hidden="true"
                    ></i>
                </button>
                <button class="signin-action" type="button">Sign in</button>
            </section>
        </header>

        <nav class="toolbar" aria-label="Mock formatting toolbar">
            <div class="toolbar-group">
                {
                    toolbarIcons.map(([label, icon]) => (
                        <button class="icon-button" type="button" aria-label={label}>
                            <i class={icon as string} aria-hidden="true"></i>
                        </button>
                    ))
                }
            </div>

            <span class="divider" aria-hidden="true" />
            <button class="select-button" type="button">
                <span>100%</span>
                <i
                    class={`${iconClasses.caretDown} tiny`}
                    aria-hidden="true"
                ></i>
            </button>
            <span class="divider" aria-hidden="true" />
            <button class="select-button wide" type="button">
                <span>Normal text</span>
                <i
                    class={`${iconClasses.caretDown} tiny`}
                    aria-hidden="true"
                ></i>
            </button>
            <button class="select-button font" type="button">
                <span>Merriweather</span>
                <i
                    class={`${iconClasses.caretDown} tiny`}
                    aria-hidden="true"
                ></i>
            </button>
            <button class="icon-button" type="button" aria-label="Decrease font size">
                <i class={iconClasses.minus} aria-hidden="true"></i>
            </button>
            <span class="font-size" aria-label="Font size">11</span>
            <button class="icon-button" type="button" aria-label="Increase font size">
                <i class={iconClasses.plus} aria-hidden="true"></i>
            </button>
            <span class="divider" aria-hidden="true" />
            <button class="text-button strong" type="button" aria-label="Bold">
                B
            </button>
            <button class="text-button italic" type="button" aria-label="Italic">
                I
            </button>
            <button class="icon-button" type="button" aria-label="Underline">
                <i class={iconClasses.underline} aria-hidden="true"></i>
            </button>
            <button class="text-button color" type="button" aria-label="Text color">
                A
            </button>
            <span class="divider" aria-hidden="true" />
            <button class="icon-button" type="button" aria-label="Link">
                <i class={iconClasses.link} aria-hidden="true"></i>
            </button>
            <button class="icon-button" type="button" aria-label="Insert image">
                <i class={iconClasses.image} aria-hidden="true"></i>
            </button>
            <button class="icon-button" type="button" aria-label="Alignment">
                <i class={iconClasses.textAlignLeft} aria-hidden="true"></i>
            </button>
            <button class="icon-button" type="button" aria-label="List">
                <i class={iconClasses.listBullets} aria-hidden="true"></i>
            </button>
            <span class="toolbar-spacer" />
            <button class="editing-button" type="button">
                <i class={iconClasses.pencil} aria-hidden="true"></i>
                <span>Editing</span>
                <i
                    class={`${iconClasses.caretDown} tiny`}
                    aria-hidden="true"
                ></i>
            </button>
        </nav>

        <div class="ruler" aria-hidden="true">
            {Array.from({ length: 22 }, (_, index) => <span>{index + 1}</span>)}
        </div>

        <div class="docs-workspace">
            <aside class="doc-tabs" aria-label="Document tabs">
                <a class="back-link" href="/" aria-label="Back to home">
                    <i class={iconClasses.arrowLeft} aria-hidden="true"></i>
                </a>
                <div class="tabs-heading">
                    <span>Document tabs</span>
                    <button type="button" aria-label="Add tab">+</button>
                </div>
                <div class="tab-pill">
                    <i class={iconClasses.tab} aria-hidden="true"></i>
                    <span>Tab 1</span>
                    <button type="button" aria-label="Tab options">
                        <i class={iconClasses.dots} aria-hidden="true"></i>
                    </button>
                </div>
                <nav class="outline" aria-label="Document outline">
                    <a href="#document-title">{article.title}</a>
                    <a href="#experience">EXPERIENCE</a>
                    <a href="#company-one">Company, Location — Jo...</a>
                    <a href="#company-two">Company, Location — Jo...</a>
                    <a href="#education">EDUCATION</a>
                    <a href="#skills">SKILLS</a>
                    <a href="#awards">AWARDS</a>
                    <a href="#languages">LANGUAGES</a>
                </nav>
            </aside>

            <section class="doc-canvas">
                <article class="doc-page">
                    <header class="resume-header">
                        <div>
                            <span class="cursor" aria-hidden="true" />
                            <h1 id="document-title">{article.title}</h1>
                            <p class="subtitle">{article.excerpt}</p>
                        </div>
                        <address>
                            123 Your Street<br />
                            Your City, ST 12345<br />
                            <strong>(123) 456-7890</strong><br />
                            <strong>no_reply@example.com</strong>
                        </address>
                    </header>

                    <div class="resume-grid">
                        <section class="main-column" aria-labelledby="experience">
                            <h2 id="experience">EXPERIENCE</h2>
                            <section id="company-one" class="entry">
                                <h3>Company, Location — <em>Job Title</em></h3>
                                <p class="eyebrow">MONTH 20XX - PRESENT</p>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetuer adipiscing
                                    elit, sed diam nonummy nibh.
                                </p>
                            </section>
                            <section id="company-two" class="entry">
                                <h3>Company, Location — <em>Job Title</em></h3>
                                <p class="eyebrow">MONTH 20XX - MONTH 20XX</p>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetuer adipiscing
                                    elit, sed diam nonummy nibh.
                                </p>
                            </section>
                            <section class="entry">
                                <h3>Company, Location — <em>Job Title</em></h3>
                                <p class="eyebrow">MONTH 20XX - MONTH 20XX</p>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetuer adipiscing
                                    elit, sed diam nonummy nibh.
                                </p>
                            </section>

                            <h2 id="education">EDUCATION</h2>
                            <section class="entry">
                                <h3>School Name, Location — <em>Degree</em></h3>
                                <p class="eyebrow">MONTH 20XX - MONTH 20XX</p>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetuer adipiscing
                                    elit, sed diam nonummy nibh euismod tincidunt ut
                                    laoreet dolore.
                                </p>
                            </section>
                            <section class="entry">
                                <h3>School Name, Location — <em>Degree</em></h3>
                                <p class="eyebrow">MONTH 20XX - MONTH 20XX</p>
                            </section>
                        </section>

                        <aside class="side-column">
                            <h2 id="skills">SKILLS</h2>
                            <p>
                                Lorem ipsum dolor sit amet. Consectetuer adipiscing
                                elit. Sed diam nonummy nibh euismod tincidunt.
                            </p>

                            <h2 id="awards">AWARDS</h2>
                            <p>
                                <strong>Lorem ipsum dolor sit amet</strong><br />
                                Consectetuer adipiscing elit, sed diam nonummy.
                            </p>
                            <p>
                                <strong>Nibh euismod tincidunt ut</strong><br />
                                Laoreet dolore magna aliquam erat volutpat.
                            </p>

                            <h2 id="languages">LANGUAGES</h2>
                            <p>
                                Lorem ipsum, dolor sit amet, consectetuer.
                            </p>
                        </aside>
                    </div>
                </article>
            </section>
        </div>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        height: 100%;
    }

    :global(body) {
        height: 100%;
        min-height: 100%;
        overflow: hidden;
        color: var(--foreground);
        background: var(--muted);
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    button,
    summary,
    a {
        font: inherit;
    }

    button {
        border: 0;
        cursor: pointer;
    }

    .docs-shell {
        width: 100%;
        height: 100vh;
        min-height: 0;
        display: grid;
        grid-template-rows: auto auto auto minmax(0, 1fr);
        overflow: hidden;
        background: var(--muted);
    }

    .docs-topbar {
        position: relative;
        z-index: 30;
        min-height: 72px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 20px 6px 26px;
        color: var(--foreground);
        background: var(--background);
    }

    .title-cluster {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .docs-logo {
        width: 28px;
        height: 38px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        color: var(--primary);
        text-decoration: none;
    }

    .title-stack {
        min-width: 0;
        display: grid;
        gap: 6px;
    }

    .title-row {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .doc-title {
        max-width: min(360px, 28vw);
        overflow: hidden;
        color: var(--foreground);
        font-size: 18px;
        line-height: 1;
        font-weight: 500;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ph,
    .ph-fill {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        line-height: 1;
    }

    .ph.subtle,
    .ph-fill.subtle {
        width: 17px;
        height: 17px;
        font-size: 17px;
        color: var(--muted-foreground);
    }

    .ph.tiny,
    .ph-fill.tiny {
        width: 14px;
        height: 14px;
        font-size: 14px;
    }

    .menu-bar {
        display: flex;
        align-items: center;
        gap: 2px;
        color: var(--foreground);
        font-size: 14px;
        line-height: 1;
        white-space: nowrap;
    }

    .menu-item {
        position: relative;
    }

    .menu-item summary {
        list-style: none;
        padding: 5px 7px;
        border-radius: var(--radius);
        cursor: pointer;
    }

    .menu-item summary::-webkit-details-marker {
        display: none;
    }

    .menu-item summary:hover,
    .menu-item[open] summary {
        background: var(--accent);
    }

    .menu-panel {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        z-index: 20;
        width: 190px;
        padding: 6px 0;
        background: var(--popover);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 8px 18px color-mix(in oklch, var(--foreground) 18%, transparent);
    }

    .menu-panel button {
        width: 100%;
        display: block;
        padding: 8px 14px;
        color: var(--popover-foreground);
        background: transparent;
        text-align: left;
        font-size: 13px;
        line-height: 1.25;
    }

    .menu-panel button:hover,
    .menu-panel button:focus-visible {
        background: var(--accent);
        outline: none;
    }

    .top-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 0;
        white-space: nowrap;
    }

    .request-access,
    .signin-action {
        height: 40px;
        border-radius: 999px;
        font-size: 14px;
        line-height: 1;
        font-weight: 700;
    }

    .request-access {
        padding: 0 20px;
        color: var(--primary);
        background: var(--background);
        border: 1px solid var(--ring);
    }

    .avatar {
        width: 38px;
        height: 38px;
        display: inline-grid;
        place-items: center;
        color: var(--primary-foreground);
        background: var(--sidebar-primary);
        border: 2px solid var(--primary);
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
    }

    .share-action {
        height: 40px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 18px;
        color: var(--secondary-foreground);
        background: var(--secondary);
        border-radius: 999px;
        font-size: 14px;
        line-height: 1;
        font-weight: 700;
    }

    .share-action .ph:first-child {
        width: 18px;
        height: 18px;
    }

    .signin-action {
        padding: 0 20px;
        color: var(--primary-foreground);
        background: var(--primary);
    }

    .toolbar {
        position: relative;
        z-index: 20;
        width: calc(100% - 32px);
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0 16px;
        padding: 5px 12px;
        overflow-x: auto;
        color: var(--accent-foreground);
        background: var(--accent);
        border-radius: 999px;
        font-size: 14px;
        line-height: 1;
        white-space: nowrap;
    }

    .toolbar-group {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .icon-button,
    .text-button {
        width: 28px;
        height: 28px;
        display: inline-grid;
        place-items: center;
        color: var(--accent-foreground);
        background: transparent;
        border-radius: var(--radius);
        font-size: 14px;
        line-height: 1;
        font-weight: 700;
    }

    .icon-button:hover,
    .text-button:hover,
    .select-button:hover,
    .editing-button:hover {
        background: color-mix(in oklch, var(--foreground) 10%, transparent);
    }

    .text-button.italic {
        font-style: italic;
    }

    .text-button.color {
        border-bottom: 2px solid var(--muted-foreground);
    }

    .select-button,
    .editing-button {
        height: 28px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 0 8px;
        color: var(--accent-foreground);
        background: transparent;
        border-radius: var(--radius);
        font-size: 14px;
        line-height: 1;
    }

    .select-button.wide {
        min-width: 120px;
        justify-content: space-between;
    }

    .select-button.font {
        min-width: 118px;
        justify-content: space-between;
    }

    .divider {
        width: 1px;
        height: 28px;
        flex: 0 0 auto;
        background: var(--border);
    }

    .font-size {
        min-width: 34px;
        height: 28px;
        display: inline-grid;
        place-items: center;
        color: var(--foreground);
        background: var(--background);
        border: 1px solid var(--input);
        border-radius: var(--radius);
        font-size: 14px;
    }

    .toolbar-spacer {
        flex: 1 0 20px;
    }

    .editing-button {
        padding: 0 10px;
        font-weight: 700;
    }

    .ruler {
        position: relative;
        z-index: 10;
        height: 27px;
        display: flex;
        align-items: end;
        gap: 39px;
        padding: 0 0 4px 338px;
        overflow: hidden;
        color: var(--muted-foreground);
        background: var(--muted);
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        line-height: 1;
        font-weight: 700;
        white-space: nowrap;
    }

    .docs-workspace {
        min-height: 0;
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        overflow: hidden;
        background: var(--muted);
    }

    .doc-tabs {
        min-height: 0;
        overflow-y: auto;
        padding: 24px 18px 42px;
        color: var(--sidebar-foreground);
        background: var(--sidebar);
        border-right: 1px solid var(--sidebar-border);
    }

    .back-link {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        margin-bottom: 40px;
        color: var(--sidebar-foreground);
        text-decoration: none;
    }

    .back-link .ph {
        width: 25px;
        height: 25px;
    }

    .tabs-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 18px 12px;
        font-size: 16px;
        line-height: 1;
        font-weight: 700;
    }

    .tabs-heading button {
        width: 26px;
        height: 26px;
        color: var(--sidebar-foreground);
        background: transparent;
        border-radius: 999px;
        font-size: 22px;
        line-height: 1;
    }

    .tab-pill {
        height: 46px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 0 16px 0 22px;
        color: var(--sidebar-primary);
        background: var(--sidebar-accent);
        border-radius: 999px;
        font-size: 15px;
        line-height: 1;
        font-weight: 700;
    }

    .tab-pill .ph {
        width: 18px;
        height: 18px;
    }

    .tab-pill button {
        width: 27px;
        height: 27px;
        display: grid;
        place-items: center;
        margin-left: auto;
        color: var(--sidebar-foreground);
        background: transparent;
        border-radius: 999px;
    }

    .outline {
        display: grid;
        gap: 18px;
        margin: 14px 0 0 30px;
        padding: 7px 0 0 22px;
        border-left: 2px solid var(--sidebar-border);
        font-size: 14px;
        line-height: 1.18;
    }

    .outline a {
        overflow: hidden;
        color: var(--sidebar-foreground);
        text-decoration: none;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .outline a:first-child {
        color: var(--sidebar-primary);
    }

    .doc-canvas {
        min-width: 0;
        min-height: 0;
        padding: 20px 28px 72px 36px;
        overflow: auto;
        overscroll-behavior: contain;
    }

    .doc-page {
        width: 820px;
        min-height: 1160px;
        margin: 0;
        padding: 64px 76px;
        color: var(--card-foreground);
        background: var(--card);
        border: 1px solid var(--border);
        box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 12%, transparent);
        font-family: Merriweather, Georgia, "Times New Roman", serif;
    }

    .resume-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 212px;
        gap: 54px;
        align-items: start;
        margin-bottom: 70px;
    }

    .cursor {
        width: 4px;
        height: 15px;
        display: block;
        margin: -14px 0 18px 2px;
        background: var(--primary);
    }

    h1,
    h2,
    h3,
    p,
    address {
        margin: 0;
        letter-spacing: 0;
    }

    h1 {
        margin-bottom: 14px;
        color: var(--card-foreground);
        font-size: 52px;
        line-height: 0.95;
        font-weight: 900;
    }

    .subtitle {
        color: var(--card-foreground);
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 14px;
        line-height: 1.35;
        font-weight: 500;
    }

    address {
        color: var(--card-foreground);
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
        line-height: 1.45;
        font-style: normal;
        font-weight: 500;
    }

    .resume-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        gap: 68px;
    }

    h2 {
        margin: 0 0 25px;
        color: var(--primary);
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
        line-height: 1;
        font-weight: 800;
    }

    h2:not(:first-child) {
        margin-top: 54px;
    }

    .entry {
        margin-bottom: 31px;
    }

