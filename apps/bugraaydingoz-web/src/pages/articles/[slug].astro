---
import SiteHeader from "../../components/SiteHeader.astro";
import Layout from "../../layouts/Layout.astro";

type ArticleFrontmatter = {
    date: string;
    excerpt: string;
    title: string;
};

type ArticleMarkdown = {
    Content: unknown;
    frontmatter: ArticleFrontmatter;
};

export function getStaticPaths() {
    const contentModules = import.meta.glob<ArticleMarkdown>(
        "../../content/articles/*.md",
        { eager: true },
    );

    return Object.entries(contentModules).map(([path, module]) => {
        const slug = path.split("/").at(-1)?.replace(".md", "");

        return {
            params: { slug },
            props: {
                article: {
                    slug,
                    ...module.frontmatter,
                },
                Content: module.Content,
            },
        };
    });
}

const { article, Content } = Astro.props;
---

<Layout
    title={`${article.title} · Buğra Aydıngöz`}
    description={article.excerpt}
    type="article"
>
    <main class="article-shell" aria-label={`${article.title} article`}>
        <SiteHeader />

        <article class="article">
            <header class="article-header">
                <h1>{article.title}</h1>
                <p class="dek">{article.excerpt}</p>
            </header>

            <div class="article-body">
                {
                    Content ? (
                        <Content />
                    ) : (
                        <p>
                            This is placeholder article copy for now. The page
                            is ready for a Markdown draft.
                        </p>
                    )
                }
            </div>
        </article>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: var(--foreground);
        background: var(--background);
    }

    .article-shell {
        width: min(100% - 40px, 680px);
        min-height: 100vh;
        margin: 0 auto;
        padding: 42px 0 84px;
    }

    .article {
        max-width: 620px;
    }

    .article-header {
        margin-bottom: 34px;
    }

    h1,
    p {
        margin: 0;
        letter-spacing: 0;
    }

    h1 {
        max-width: 560px;
        color: var(--foreground);
        font-size: 28px;
        line-height: 1.2;
        font-weight: 500;
    }

    .dek {
        max-width: 540px;
        margin-top: 14px;
        color: var(--muted-foreground);
        font-size: 16px;
        line-height: 1.65;
    }

    .article-body {
        display: grid;
        gap: 20px;
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.72;
    }

    .article-body :global(h2) {
        margin: 18px 0 0;
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.35;
        font-weight: 700;
    }

    .article-body :global(p),
    .article-body :global(pre),
    .article-body :global(ul),
    .article-body :global(ol),
    .article-body :global(blockquote) {
        margin: 0;
    }

    .article-body :global(code) {
        color: var(--foreground);
        background: var(--accent);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.08em 0.32em;
        font-family:
            ui-monospace, SFMono-Regular, "SF Mono", Consolas,
            "Liberation Mono", monospace;
        font-size: 0.88em;
    }

    .article-body :global(pre) {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--accent);
        padding: 16px;
        line-height: 1.6;
    }

    .article-body :global(pre code) {
        display: block;
        border: 0;
        background: transparent;
        padding: 0;
        font-size: 13px;
    }

    @media (max-width: 720px) {
        .article-shell {
            width: min(100% - 32px, 680px);
            padding-top: 28px;
        }
    }
</style>
