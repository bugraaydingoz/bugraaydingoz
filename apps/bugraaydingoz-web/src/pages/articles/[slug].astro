---
import { articles } from "../../data/articles";
import SiteHeader from "../../components/SiteHeader.astro";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
    return articles.map((article) => ({
        params: { slug: article.slug },
        props: { article },
    }));
}

const { article } = Astro.props;
---

<Layout
    title={`${article.title} · Buğra Aydıngöz`}
    description={article.excerpt}
    type="article"
>
    <main class="article-shell" aria-label={`${article.title} article`}>
        <SiteHeader />

        <article class="article">
            <a class="back-link" href="/">Back to writing</a>

            <header class="article-header">
                <p class="article-meta">
                    {article.date} · {article.readTime}
                </p>
                <h1>{article.title}</h1>
                <p class="dek">{article.excerpt}</p>
            </header>

            <div class="article-body">
                <p>
                    This is placeholder article copy for now. The shape of the
                    page is intentionally simple: a quiet column, generous line
                    height, and just enough hierarchy to make reading feel easy.
                </p>
                <p>
                    I care about software that feels calm under repeated use.
                    That usually comes from small decisions: useful defaults,
                    honest loading states, predictable layout, and controls that
                    do not ask for more attention than they deserve.
                </p>
                <h2>Working Notes</h2>
                <p>
                    Product engineering sits in a useful middle. It asks you to
                    understand the material of the interface, the tradeoffs in
                    the system, and the human rhythm around the product.
                </p>
                <p>
                    The best work often feels almost plain once it is finished.
                    It is not empty; it is edited. The unnecessary decisions have
                    been removed so the useful ones can stay visible.
                </p>
                <h2>Draft Direction</h2>
                <p>
                    When the real article is ready, this page can hold it without
                    needing a new design language. The point is to keep the page
                    out of the way and let the writing carry the weight.
                </p>
            </div>
        </article>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: var(--foreground);
        background: var(--background);
    }

    .article-shell {
        width: min(100% - 40px, 680px);
        min-height: 100vh;
        margin: 0 auto;
        padding: 42px 0 84px;
    }

    .back-link {
        color: var(--foreground);
        text-decoration: none;
    }

    .back-link,
    .article-meta {
        color: var(--muted-foreground);
        font-size: 14px;
        line-height: 1.45;
    }

    .back-link:hover,
    .back-link:focus-visible {
        color: var(--primary);
    }

    .article {
        max-width: 620px;
    }

    .back-link {
        display: inline-flex;
        margin-bottom: 44px;
    }

    .article-header {
        margin-bottom: 42px;
    }

    h1,
    h2,
    p {
        margin: 0;
        letter-spacing: 0;
    }

    .article-meta {
        margin-bottom: 14px;
    }

    h1 {
        max-width: 560px;
        color: var(--foreground);
        font-size: clamp(2.35rem, 7vw, 4.4rem);
        line-height: 1.02;
        font-weight: 500;
    }

    .dek {
        max-width: 540px;
        margin-top: 20px;
        color: var(--muted-foreground);
        font-size: 16px;
        line-height: 1.65;
    }

    .article-body {
        display: grid;
        gap: 22px;
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.78;
    }

    h2 {
        margin-top: 22px;
        color: var(--foreground);
        font-size: 20px;
        line-height: 1.35;
        font-weight: 600;
    }

    @media (max-width: 720px) {
        .article-shell {
            width: min(100% - 32px, 680px);
            padding-top: 28px;
        }
    }
</style>
