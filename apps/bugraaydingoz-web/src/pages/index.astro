---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="home" aria-label="Portfolio introduction">
        <header class="topbar">
            <a href="/" class="brand">Buğra Aydıngöz</a>
            <nav class="header-links" aria-label="Contact links">
                <a href="mailto:hello@bugraaydingoz.com"
                    >hello@bugraaydingoz.com</a
                >
                <a
                    class="linkedin-link"
                    href="https://www.linkedin.com/in/bugraaydingoz/"
                    target="_blank"
                    rel="noreferrer"
                >
                    in/bugraaydingoz
                </a>
            </nav>
        </header>

        <section class="hero">
            <figure class="portrait">
                <img
                    src="/bugra-aydingoz.jpeg"
                    alt="Buğra Aydıngöz smiling outdoors"
                />
            </figure>

            <h1>
                <span>Product</span>
                <span>Engineer</span>
            </h1>

            <p class="intro">
                I’m Buğra, crafting intuitive, user-focused applications.
            </p>
        </section>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: #282a2c;
        background: #f7f7f7;
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .home {
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        gap: clamp(34px, 6vh, 84px);
        padding: clamp(28px, 4.6vw, 64px) clamp(22px, 9.4vw, 186px)
            clamp(34px, 5.8vw, 104px);
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .brand,
    .header-links a {
        color: #282a2c;
        text-decoration: none;
        font-size: clamp(1.18rem, 1.7vw, 1.75rem);
        line-height: 1;
        font-weight: 500;
    }

    .header-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(18px, 3vw, 44px);
    }

    .header-links a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(1.02rem, 1.32vw, 1.5rem);
    }

    .header-links svg {
        width: 0.9em;
        height: 0.9em;
        fill: currentColor;
        flex: 0 0 auto;
    }

    .header-links a:hover,
    .header-links a:focus-visible {
        color: #4b8d8a;
    }

    .hero {
        position: relative;
        min-height: 600px;
        display: grid;
        grid-template-areas:
            "title portrait"
            "title spacer"
            "title intro";
        align-items: end;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
        grid-template-rows: auto 1fr auto;
        column-gap: clamp(42px, 7vw, 116px);
        padding-top: clamp(18px, 5vh, 56px);
    }

    h1 {
        margin: 0;
        grid-area: title;
        align-self: end;
        color: #282a2c;
        font-size: clamp(6.2rem, 10.5vw, 10rem);
        line-height: 1.0625;
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    h1 span {
        display: block;
    }

    .portrait {
        width: min(100%, 300px);
        aspect-ratio: 328 / 402;
        margin: 0;
        grid-area: portrait;
        justify-self: end;
        align-self: start;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 18px 44px rgba(17, 24, 39, 0.12);
    }

    .portrait img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .intro {
        margin: 0 0 clamp(8px, 1.5vw, 22px);
        grid-area: intro;
        justify-self: end;
        align-self: end;
        max-width: 390px;
        color: #0c0d0e;
        font-size: clamp(1.28rem, 1.68vw, 1.72rem);
        line-height: 1.35;
        font-weight: 500;
    }

    @media (min-width: 981px) {
        h1 {
            font-size: 160px;
            line-height: 170px;
            letter-spacing: -0.02em;
        }
    }

    @media (max-width: 980px) {
        .home {
            gap: 48px;
        }

        .hero {
            min-height: auto;
            grid-template-columns: 1fr;
            grid-template-areas:
                "portrait"
                "title"
                "intro";
            gap: 34px;
            align-items: start;
        }

        .portrait {
            width: min(100%, 340px);
            justify-self: start;
            order: -1;
        }

        h1,
        .intro {
            justify-self: start;
        }

        .intro {
            max-width: 560px;
            margin: 0;
        }
    }

    @media (max-width: 680px) {
        .home {
            padding: 26px 20px 48px;
        }

        .topbar {
            align-items: flex-start;
            flex-direction: column;
            gap: 14px;
        }

        .header-links {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        h1 {
            font-size: clamp(4.58rem, 22vw, 6.1rem);
        }
    }
</style>
