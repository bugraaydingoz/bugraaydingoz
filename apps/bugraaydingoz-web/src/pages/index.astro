---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="home" aria-label="Portfolio introduction">
        <header class="topbar">
            <a href="/" class="brand">Buğra Aydıngöz</a>
            <nav class="header-links" aria-label="Contact links">
                <a href="mailto:hello@bugraaydingoz.com"
                    >hello@bugraaydingoz.com</a
                >
            </nav>
        </header>

        <section class="hero">
            <figure class="portrait">
                <img
                    src="/bugra-aydingoz.jpeg"
                    width="230"
                    height="282"
                    alt="Buğra Aydıngöz smiling outdoors"
                />
            </figure>

            <h1>
                <span>Product</span>
                <span>Engineer</span>
            </h1>

            <p class="intro">
                I’m Buğra, crafting intuitive, user-focused applications.
            </p>
        </section>

        <a
            class="company-chips"
            href="https://www.linkedin.com/in/bugraaydingoz/"
            target="_blank"
            rel="noreferrer"
            aria-label="View Buğra Aydıngöz on LinkedIn"
        >
            <span class="company-chip">
                <img
                    class="company-logo"
                    src="/company-logos/scalable-capital.svg"
                    alt=""
                    loading="lazy"
                />
                <span>Scalable Capital</span>
            </span>
            <span class="company-chip">
                <img
                    class="company-logo"
                    src="/company-logos/needle.svg"
                    alt=""
                    loading="lazy"
                />
                <span>Needle</span>
            </span>
            <span class="company-chip">
                <img
                    class="company-logo"
                    src="/company-logos/digital-turbine.svg"
                    alt=""
                    loading="lazy"
                />
                <span>Digital Turbine</span>
            </span>
            <span class="company-chip">
                <span class="company-logo ki-logo" aria-hidden="true">
                    <img
                        class="ki-path ki-path-1"
                        src="/company-logos/ki-group-path-1.svg"
                        alt=""
                        loading="lazy"
                    />
                    <img
                        class="ki-path ki-path-2"
                        src="/company-logos/ki-group-path-2.svg"
                        alt=""
                        loading="lazy"
                    />
                    <img
                        class="ki-path ki-path-3"
                        src="/company-logos/ki-group-path-3.svg"
                        alt=""
                        loading="lazy"
                    />
                    <img
                        class="ki-path ki-path-4"
                        src="/company-logos/ki-group-path-4.svg"
                        alt=""
                        loading="lazy"
                    />
                </span>
                <span>KI Group</span>
            </span>
        </a>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: #282a2c;
        background: #f7f7f7;
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .home {
        width: min(100%, 1200px);
        min-height: 100vh;
        margin: 0 auto;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: clamp(28px, 4.8vh, 64px);
        padding: clamp(28px, 4.6vw, 64px) 0 clamp(34px, 5.8vw, 104px);
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .brand,
    .header-links a {
        color: #282a2c;
        text-decoration: none;
        font-size: clamp(1.18rem, 1.7vw, 1.75rem);
        line-height: 1;
        font-weight: 500;
    }

    .header-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .header-links a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(1.02rem, 1.32vw, 1.5rem);
    }

    .header-links svg {
        width: 0.9em;
        height: 0.9em;
        fill: currentColor;
        flex: 0 0 auto;
    }

    .header-links a:hover,
    .header-links a:focus-visible {
        color: #4b8d8a;
    }

    .hero {
        position: relative;
        min-height: 600px;
        display: grid;
        grid-template-areas:
            "title portrait"
            "title spacer"
            "title intro";
        align-items: end;
        grid-template-columns: minmax(0, 1fr) 300px;
        grid-template-rows: auto 1fr auto;
        column-gap: clamp(42px, 7vw, 116px);
        padding-top: clamp(18px, 5vh, 56px);
    }

    h1 {
        margin: 0;
        grid-area: title;
        align-self: end;
        color: #282a2c;
        font-size: clamp(6.2rem, 10.5vw, 10rem);
        line-height: 1.0625;
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    h1 span {
        display: block;
    }

    .portrait {
        width: 230px;
        height: 282px;
        min-width: 230px;
        min-height: 282px;
        margin: 0;
        grid-area: portrait;
        justify-self: end;
        align-self: start;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 18px 44px rgba(17, 24, 39, 0.12);
    }

    .portrait img {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 230 / 282;
        object-fit: cover;
    }

    .intro {
        margin: 0 0 clamp(8px, 1.5vw, 22px);
        grid-area: intro;
        justify-self: end;
        align-self: end;
        max-width: 100%;
        color: #0c0d0e;
        font-size: 24px;
        line-height: 1.35;
        font-weight: 500;
        text-align: right;
    }

    .company-chips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 20px;
        width: 100%;
        margin-top: 170px;
        color: inherit;
        text-decoration: none;
    }

    .company-chip {
        min-width: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 12px 24px;
        color: #292b2c;
        background: rgba(249, 246, 245, 0.5);
        border: 2px solid #e9e5e3;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(12, 12, 13, 0.05);
        font-size: clamp(1.2rem, 1.65vw, 1.5rem);
        line-height: 1;
        font-weight: 700;
        white-space: nowrap;
    }

    .company-chips:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
        border-radius: 999px;
    }

    .company-logo {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        object-fit: contain;
    }

    .ki-logo {
        position: relative;
        display: block;
    }

    .ki-path {
        position: absolute;
        display: block;
    }

    .ki-path-1 {
        top: 16.74%;
        left: -0.47%;
        width: 44.5%;
        height: 66.51%;
    }

    .ki-path-2 {
        top: 16.74%;
        left: 44.04%;
        width: 22.25%;
        height: 22.15%;
    }

    .ki-path-3 {
        top: 61.08%;
        left: 44.04%;
        width: 22.25%;
        height: 22.19%;
    }

    .ki-path-4 {
        top: 16.74%;
        left: 78.23%;
        width: 22.24%;
        height: 66.52%;
    }

    @media (min-width: 981px) {
        h1 {
            font-size: 160px;
            line-height: 170px;
            letter-spacing: -0.02em;
        }
    }

    @media (max-width: 980px) {
        .home {
            width: auto;
            margin: 0;
            padding-right: clamp(22px, 9.4vw, 64px);
            padding-left: clamp(22px, 9.4vw, 64px);
            gap: 48px;
        }

        .hero {
            min-height: auto;
            grid-template-columns: 1fr;
            grid-template-areas:
                "portrait"
                "title"
                "intro";
            gap: 34px;
            align-items: start;
        }

        .portrait {
            width: min(100%, 340px);
            min-width: 0;
            height: auto;
            min-height: 0;
            aspect-ratio: 328 / 402;
            justify-self: start;
            order: -1;
        }

        h1,
        .intro {
            justify-self: start;
        }

        .intro {
            max-width: 560px;
            margin: 0;
            text-align: left;
        }

        .company-chips {
            justify-content: flex-start;
        }
    }

    @media (max-width: 680px) {
        .home {
            padding: 26px 20px 48px;
        }

        .topbar {
            align-items: flex-start;
            flex-direction: column;
            gap: 14px;
        }

        .header-links {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        h1 {
            font-size: clamp(4.58rem, 22vw, 6.1rem);
        }

        .company-chips {
            gap: 12px;
            margin-top: 40px;
        }

        .company-chip {
            gap: 10px;
            max-width: 100%;
            padding: 10px 16px;
            font-size: clamp(0.98rem, 4.8vw, 1.12rem);
        }

        .company-logo {
            width: 28px;
            height: 28px;
            flex-basis: 28px;
        }
    }
</style>
