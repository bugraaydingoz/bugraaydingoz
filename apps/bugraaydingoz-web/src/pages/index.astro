---
import { articles } from "../data/articles";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="home" aria-label="Portfolio introduction">
        <header class="topbar">
            <a href="/" class="brand">Buğra Aydıngöz</a>
            <nav class="header-links" aria-label="Contact links">
                <a href="mailto:hello@bugraaydingoz.com"
                    >hello@bugraaydingoz.com</a
                >
                <button
                    class="theme-toggle"
                    type="button"
                    data-theme-toggle
                    aria-label="Switch to dark mode"
                    aria-pressed="false"
                >
                    <i
                        class="ph ph-moon theme-toggle-moon"
                        aria-hidden="true"
                    ></i>
                    <i
                        class="ph ph-sun theme-toggle-sun"
                        aria-hidden="true"
                    ></i>
                </button>
            </nav>
        </header>

        <section class="hero">
            <figure class="portrait">
                <img
                    src="/bugra-aydingoz.jpeg"
                    width="230"
                    height="282"
                    alt="Buğra Aydıngöz smiling outdoors"
                />
            </figure>

            <h1>
                <span>Product</span>
                <span>Engineer</span>
            </h1>

            <p class="intro">
                I’m Buğra, crafting intuitive, user-focused applications.
            </p>
        </section>

        <section class="recent-articles" aria-labelledby="recent-articles">
            <h2 id="recent-articles">Recent articles</h2>
            <div class="article-grid">
                {
                    articles.map((article, index) => (
                        <a
                            class="article-card"
                            href={`/articles/${article.slug}`}
                            aria-label={`Open ${article.title}`}
                        >
                            <span
                                class={`article-preview template-${index % 6}`}
                                aria-hidden="true"
                            >
                                {
                                    article.pinned && (
                                        <span class="pinned-star">
                                            <i
                                                class="ph-fill ph-star"
                                                aria-hidden="true"
                                            ></i>
                                        </span>
                                    )
                                }
                                <span class="doc-template">
                                    <span class="doc-template-heading">
                                        {article.title}
                                    </span>
                                    <span class="doc-template-meta">
                                        {article.date} · {article.readTime}
                                    </span>
                                    <span class="doc-template-accent" />
                                    <span class="doc-template-image" />
                                    <span class="doc-template-body">
                                        <span>{article.excerpt}</span>
                                        <span>
                                            Mock content sits here as a miniature
                                            document preview, similar to a Google
                                            Docs template thumbnail.
                                        </span>
                                    </span>
                                    <span class="doc-template-side">
                                        <span>Notes</span>
                                        <span>Draft outline</span>
                                        <span>Product detail</span>
                                    </span>
                                    <span class="doc-template-footer" />
                                </span>
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: var(--foreground);
        background: var(--background);
        font-family:
            "Satoshi", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .home {
        width: min(100%, 1200px);
        min-height: 100vh;
        margin: 0 auto;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto auto;
        gap: clamp(28px, 4.8vh, 64px);
        padding: clamp(28px, 4.6vw, 64px) 0 clamp(34px, 5.8vw, 104px);
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .brand,
    .header-links a {
        color: var(--foreground);
        text-decoration: none;
        font-size: clamp(1.18rem, 1.7vw, 1.75rem);
        line-height: 1;
        font-weight: 500;
    }

    .header-links {
        display: flex;
        align-items: center;
        gap: 14px;
        justify-content: flex-end;
    }

    .header-links a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(1.02rem, 1.32vw, 1.5rem);
    }

    .header-links svg {
        width: 0.9em;
        height: 0.9em;
        fill: currentColor;
        flex: 0 0 auto;
    }

    .header-links a:hover,
    .header-links a:focus-visible {
        color: var(--primary);
    }

    .hero {
        position: relative;
        min-height: 600px;
        display: grid;
        grid-template-areas:
            "title portrait"
            "title spacer"
            "title intro";
        align-items: end;
        grid-template-columns: minmax(0, 1fr) 307px;
        grid-template-rows: auto 1fr auto;
        column-gap: clamp(42px, 7vw, 116px);
        padding-top: clamp(18px, 5vh, 56px);
    }

    h1 {
        margin: 0;
        grid-area: title;
        align-self: end;
        color: var(--foreground);
        font-size: clamp(6.2rem, 10.5vw, 10rem);
        line-height: 1.0625;
        font-weight: 400;
        letter-spacing: -0.02em;
    }

    h1 span {
        display: block;
    }

    .portrait {
        width: 230px;
        height: 282px;
        min-width: 230px;
        min-height: 282px;
        margin: 0;
        grid-area: portrait;
        justify-self: end;
        align-self: start;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 18px 44px color-mix(in oklch, var(--foreground) 12%, transparent);
    }

    .portrait img {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 230 / 282;
        object-fit: cover;
    }

    .intro {
        margin: 0 0 clamp(8px, 1.5vw, 22px);
        grid-area: intro;
        justify-self: end;
        align-self: end;
        width: 307px;
        max-width: 100%;
        color: var(--foreground);
        font-size: 24px;
        line-height: 1.35;
        font-weight: 500;
        text-align: right;
    }

    :global(.recent-articles) {
        margin-top: clamp(96px, 12vw, 170px);
        padding: 0 0 20px;
    }

    :global(.recent-articles h2) {
        margin: 0 0 64px;
        color: var(--foreground);
        font-size: 24px;
        line-height: 1.25;
        font-weight: 500;
        letter-spacing: 0;
    }

    :global(.article-grid) {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 32px;
    }

    :global(.article-card) {
        min-width: 0;
        display: block;
        color: inherit;
        text-decoration: none;
    }

    :global(.article-preview) {
        position: relative;
        display: block;
        aspect-ratio: 595 / 842;
        padding: 0;
        overflow: visible;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 1px 3px color-mix(in oklch, var(--foreground) 8%, transparent);
    }

    :global(.pinned-star) {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 26px;
        height: 26px;
        color: var(--primary-foreground);
        background: var(--primary);
        border: 1px solid color-mix(in oklch, var(--primary) 34%, var(--border));
        border-radius: 999px;
        box-shadow: 0 1px 3px color-mix(in oklch, var(--foreground) 12%, transparent);
        font-size: 14px;
        line-height: 1;
    }

    :global(.pinned-star i) {
        font-size: 15px;
        line-height: 1;
    }

    :global(.doc-template) {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        padding: 28px 26px;
        overflow: hidden;
    }

    :global(.doc-template-heading),
    :global(.doc-template-meta),
    :global(.doc-template-accent),
    :global(.doc-template-image),
    :global(.doc-template-body),
    :global(.doc-template-body span),
    :global(.doc-template-side),
    :global(.doc-template-side span),
    :global(.doc-template-footer) {
        display: block;
    }

    :global(.doc-template-heading) {
        max-width: 74%;
        color: var(--card-foreground);
        font-size: 14px;
        line-height: 1.12;
        font-weight: 700;
    }

    :global(.doc-template-meta) {
        margin-top: 7px;
        color: var(--muted-foreground);
        font-size: 7px;
        line-height: 1.4;
    }

    :global(.doc-template-accent) {
        width: 100%;
        height: 2px;
        margin-top: 14px;
        background: var(--primary);
    }

    :global(.doc-template-image) {
        width: 100%;
        height: 84px;
        margin-top: 10px;
        background:
            linear-gradient(135deg, color-mix(in oklch, var(--primary) 20%, transparent), transparent 46%),
            linear-gradient(45deg, var(--chart-1) 0 34%, var(--primary) 34% 72%, var(--chart-4) 72%);
    }

    :global(.doc-template-body) {
        margin-top: 12px;
        color: var(--muted-foreground);
        font-size: 6.5px;
        line-height: 1.45;
    }

    :global(.doc-template-body span + span) {
        margin-top: 8px;
    }

    :global(.doc-template-side) {
        position: absolute;
        top: 54px;
        right: 24px;
        width: 52px;
        color: var(--muted-foreground);
        font-size: 5.5px;
        line-height: 1.4;
    }

    :global(.doc-template-side span:first-child) {
        color: var(--primary);
        font-size: 7px;
        font-weight: 700;
    }

    :global(.doc-template-side span + span) {
        margin-top: 8px;
    }

    :global(.doc-template-footer) {
        position: absolute;
        right: 26px;
        bottom: 24px;
        left: 26px;
        height: 2px;
        background: color-mix(in oklch, var(--primary) 72%, var(--card));
    }

    :global(.template-0 .doc-template) {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        column-gap: 18px;
        padding: 28px 24px;
    }

    :global(.template-0 .doc-template-heading) {
        grid-column: 1 / -1;
        font-size: 18px;
    }

    :global(.template-0 .doc-template-meta),
    :global(.template-0 .doc-template-accent),
    :global(.template-0 .doc-template-image),
    :global(.template-0 .doc-template-footer) {
        display: none;
    }

    :global(.template-0 .doc-template-body) {
        margin-top: 18px;
        font-size: 5.8px;
    }

    :global(.template-0 .doc-template-side) {
        position: static;
        width: auto;
        margin-top: 18px;
        font-size: 5.8px;
    }

    :global(.template-1 .doc-template-heading) {
        max-width: 46%;
        color: var(--destructive);
        font-size: 8px;
    }

    :global(.template-1 .doc-template-accent),
    :global(.template-1 .doc-template-image),
    :global(.template-1 .doc-template-footer) {
        display: none;
    }

    :global(.template-1 .doc-template-body) {
        width: 78%;
        margin-top: 20px;
        margin-left: 28px;
        font-size: 5.8px;
    }

    :global(.template-1 .doc-template-side) {
        top: 76px;
        left: 28px;
        right: auto;
        width: 70px;
    }

    :global(.template-2 .doc-template-heading) {
        max-width: 100%;
        font-size: 14px;
        text-transform: uppercase;
    }

    :global(.template-2 .doc-template-image) {
        height: 110px;
        background:
            radial-gradient(circle at 50% 35%, color-mix(in oklch, var(--card) 40%, transparent), transparent 24%),
            linear-gradient(135deg, var(--muted), var(--chart-1));
    }

    :global(.template-2 .doc-template-side) {
        display: none;
    }

    :global(.template-3 .doc-template-accent) {
        height: 4px;
        background: var(--primary);
    }

    :global(.template-3 .doc-template-image),
    :global(.template-3 .doc-template-footer) {
        display: none;
    }

    :global(.template-3 .doc-template-heading) {
        margin-top: 44px;
        font-size: 8px;
        color: var(--primary);
    }

    :global(.template-3 .doc-template-body) {
        width: 74%;
        margin-top: 22px;
    }

    :global(.template-3 .doc-template-side) {
        top: 66px;
        left: 26px;
        right: auto;
        width: 86px;
    }

    :global(.template-4 .doc-template-accent) {
        height: 4px;
        background: linear-gradient(90deg, var(--chart-1), var(--chart-2), var(--primary), var(--chart-4));
    }

    :global(.template-4 .doc-template-heading) {
        margin-top: 12px;
        color: var(--accent-foreground);
        font-size: 18px;
    }

    :global(.template-4 .doc-template-meta) {
        color: var(--muted-foreground);
    }

    :global(.template-4 .doc-template-image) {
        height: 106px;
    }

    :global(.template-4 .doc-template-body) {
        display: none;
    }

    :global(.template-4 .doc-template-side) {
        top: auto;
        right: auto;
        bottom: 32px;
        left: 26px;
        width: 80px;
        color: var(--primary);
    }

    :global(.template-4 .doc-template-footer) {
        display: none;
    }

    :global(.template-5 .doc-template-heading) {
        color: var(--primary);
        font-size: 14px;
        font-weight: 500;
    }

    :global(.template-5 .doc-template-image) {
        position: absolute;
        top: 114px;
        left: 26px;
        width: 74px;
        height: 86px;
        margin: 0;
        background: linear-gradient(135deg, var(--primary), var(--sidebar-primary));
        border-radius: var(--radius);
    }

    :global(.template-5 .doc-template-body) {
        width: calc(100% - 92px);
        margin-top: 28px;
        margin-left: 92px;
    }

    :global(.template-5 .doc-template-side) {
        top: 88px;
        right: 28px;
        width: 80px;
    }

    :global(.template-5 .doc-template-footer) {
        right: 0;
        bottom: 0;
        left: auto;
        width: 74px;
        height: 44px;
        background: linear-gradient(135deg, var(--primary), var(--sidebar-primary));
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    :global(.article-card:hover .article-preview),
    :global(.article-card:focus-visible .article-preview) {
        border-color: var(--ring);
        box-shadow: 0 3px 10px color-mix(in oklch, var(--foreground) 10%, transparent);
    }

    :global(.article-card:focus-visible) {
        outline: 2px solid currentColor;
        outline-offset: 8px;
        border-radius: var(--radius);
    }

    @media (min-width: 981px) {
        h1 {
            font-size: 160px;
            line-height: 170px;
            letter-spacing: -0.02em;
        }
    }

    @media (max-width: 980px) {
        .home {
            width: auto;
            margin: 0;
            padding-right: clamp(22px, 9.4vw, 64px);
            padding-left: clamp(22px, 9.4vw, 64px);
            gap: 48px;
        }

        .hero {
            min-height: auto;
            grid-template-columns: 1fr;
            grid-template-areas:
                "portrait"
                "title"
                "intro";
            gap: 34px;
            align-items: start;
        }

        .portrait {
            width: min(100%, 340px);
            min-width: 0;
            height: auto;
            min-height: 0;
            aspect-ratio: 328 / 402;
            justify-self: start;
            order: -1;
        }

        h1,
        .intro {
            justify-self: start;
        }

        .intro {
            max-width: 560px;
            margin: 0;
            text-align: left;
        }

        :global(.recent-articles) {
            margin-top: 72px;
        }

        :global(.article-grid) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 680px) {
        .home {
            padding: 26px 20px 48px;
        }

        .topbar {
            align-items: flex-start;
            flex-direction: column;
            gap: 14px;
        }

        .header-links {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        h1 {
            font-size: clamp(4.58rem, 22vw, 6.1rem);
        }

        :global(.recent-articles) {
            margin-top: 56px;
        }

        :global(.recent-articles h2) {
            margin-bottom: 28px;
        }

        :global(.article-grid) {
            grid-template-columns: 1fr;
            gap: 22px;
        }
    }
</style>
