---
import FigmaBox from "../components/FigmaBox.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";

type ArticleFrontmatter = {
    date: Date | string;
    description: string;
    title: string;
};

type ArticleMarkdown = {
    frontmatter: ArticleFrontmatter;
};

const contacts = [
    ["Email", "hello@bugraaydingoz.com", "mailto:hello@bugraaydingoz.com"],
    ["LinkedIn", "bugraaydingoz", "https://www.linkedin.com/in/bugraaydingoz/"],
    ["X", "bugraaydingoz", "https://x.com/bugraaydingoz"],
    ["GitHub", "bugraaydingoz", "https://github.com/bugraaydingoz"],
];

const work = [
    [
        "2026 — Present",
        "Senior Software Engineer at Scalable Capital",
        "Munich, Germany",
        "https://scalable.capital/",
    ],
    [
        "2025 — 2025",
        "Founding Software Engineer at Needle",
        "Berlin, Germany",
        "https://needle-ai.com/",
    ],
    [
        "2020 — 2025",
        "Senior Software Engineer at Digital Turbine (Fyber)",
        "Berlin, Germany",
        "https://www.digitalturbine.com/",
    ],
    [
        "2019 — 2020",
        "Software Engineer at KI Group",
        "Munich, Germany",
        "https://kigroup.de/",
    ],
    [
        "2018 — 2019",
        "Software Engineer at Breeze Technologies",
        "Hamburg, Germany",
        "https://www.breeze-technologies.de/",
    ],
];

const articleModules = import.meta.glob<ArticleMarkdown>(
    "../content/articles/*.md",
    { eager: true },
);

const writing = Object.entries(articleModules)
    .map(([path, module]) => {
        const slug = path.split("/").at(-1)?.replace(".md", "");
        const date =
            module.frontmatter.date instanceof Date
                ? module.frontmatter.date
                : new Date(module.frontmatter.date);

        return {
            date,
            description: module.frontmatter.description,
            href: `/articles/${slug}`,
            title: module.frontmatter.title,
        };
    })
    .sort((a, b) => b.date.getTime() - a.date.getTime());

const dateFormatter = new Intl.DateTimeFormat("en", {
    month: "short",
    year: "numeric",
});
---

<Layout>
    <main class="site-shell" aria-label="Portfolio introduction">
        <SiteHeader />

        <section class="portrait-section" aria-label="Portrait"></section>

        <section class="section" aria-labelledby="about-title">
            <FigmaBox>
                <img
                    src="/bugra-aydingoz-portrait.jpeg"
                    width="236"
                    height="236"
                    alt="Buğra Aydıngöz portrait"
                />
            </FigmaBox>
            <p>
                I am a Product Engineer with 8+ years of experience creating
                intuitive, user-focused applications. I have strong expertise in
                frontend development and design (TypeScript, React, Figma),
                complemented by backend skills (Node.js, Go, and MySQL) and
                leading teams.
            </p>
        </section>

        <section class="section" aria-labelledby="writing-title">
            <h2 id="writing-title">Writing</h2>
            <div class="row-list">
                {
                    writing.map((article) => (
                        <a class="info-row writing-link" href={article.href}>
                            <span class="row-label">
                                {dateFormatter.format(article.date)}
                            </span>
                            <span class="row-content">
                                <span class="row-title">{article.title}</span>
                                <span class="row-subtitle">
                                    {article.description}
                                </span>
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="section" aria-labelledby="work-title">
            <h2 id="work-title">Work</h2>
            <div class="row-list work-list">
                {
                    work.map(([period, title, location, href]) => (
                        <a
                            class="info-row work-link"
                            href={href}
                            target="_blank"
                            rel="noreferrer"
                        >
                            <span class="row-label">{period}</span>
                            <span class="row-content">
                                <span class="row-title">{title}</span>
                                <span class="row-subtitle">{location}</span>
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>

        <section
            class="section contact-section"
            id="contact"
            aria-labelledby="contact-title"
        >
            <h2 id="contact-title">Contact</h2>
            <div class="row-list">
                {
                    contacts.map(([label, value, href]) => (
                        <a
                            class="info-row contact-link"
                            href={href}
                            target="_blank"
                            rel="noreferrer"
                        >
                            <span class="row-label">{label}</span>
                            <span class="row-content">
                                <span class="row-title">{value}</span>
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(body) {
        min-height: 100%;
        overflow-x: hidden;
        color: var(--foreground);
        background: var(--background);
        font-family:
            "Satoshi", Inter, "Inter Variable", Roboto, "Helvetica Neue", Arial,
            sans-serif;
    }

    .site-shell {
        width: min(100% - 40px, 680px);
        min-height: 100vh;
        margin: 0 auto;
        padding: 42px 0 84px;
    }

    .writing-link,
    .work-link,
    .contact-link {
        color: var(--foreground);
        text-decoration: none !important;
    }

    .writing-link *,
    .work-link *,
    .contact-link * {
        text-decoration: none;
    }

    .portrait-section {
        margin-bottom: 72px;
    }

    .writing-link:hover .row-title,
    .writing-link:focus-visible .row-title,
    .work-link:hover .row-title,
    .work-link:focus-visible .row-title,
    .contact-link:hover .row-title,
    .contact-link:focus-visible .row-title {
        color: var(--primary);
    }

    h2,
    p {
        margin: 0;
        letter-spacing: 0;
    }

    .section {
        display: grid;
        gap: 26px;
        padding: 0;
    }

    .section + .section {
        margin-top: 64px;
    }

    h2 {
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.35;
    }

    .row-label {
        color: var(--muted-foreground);
        font-size: 14px;
        line-height: 1.35;
    }

    .section > p {
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.7;
    }

    .row-list {
        display: grid;
        gap: 28px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 34px;
        align-items: baseline;
    }

    .row-content {
        min-width: 0;
        display: grid;
        gap: 7px;
        color: var(--foreground);
        font-size: 16px;
        line-height: 1.35;
    }

    .row-title {
        color: var(--foreground);
        transition: color 160ms ease;
    }

    .writing-link:focus-visible,
    .work-link:focus-visible,
    .contact-link:focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 8px;
    }

    .row-subtitle {
        color: var(--muted-foreground);
        font-size: 14px;
        line-height: 1.45;
    }

    .contact-section {
        padding-bottom: 56px;
    }

    @media (max-width: 720px) {
        .site-shell {
            width: min(100% - 32px, 680px);
            padding-top: 28px;
        }

        .info-row {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .portrait-section {
            margin-bottom: 56px;
        }

        .section + .section {
            margin-top: 54px;
        }

        h2,
        .row-content,
        .section > p {
            font-size: 16px;
        }

        .row-label {
            font-size: 14px;
        }

        .row-list {
            gap: 24px;
        }
    }
</style>
