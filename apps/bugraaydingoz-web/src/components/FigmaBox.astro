<figure class="box" data-figma-box tabindex="0" aria-label={`Figma frame`}>
    <div class="frame">
        <div class="content">
            <slot />
        </div>
        <span class="corner corner--tl" data-resize-handle="tl"></span>
        <span class="corner corner--tr" data-resize-handle="tr"></span>
        <span class="corner corner--br" data-resize-handle="br"></span>
        <span class="corner corner--bl" data-resize-handle="bl"></span>
        <span class="edge edge--top" data-resize-handle="t"></span>
        <span class="edge edge--right" data-resize-handle="r"></span>
        <span class="edge edge--bottom" data-resize-handle="b"></span>
        <span class="edge edge--left" data-resize-handle="l"></span>
        <span class="radius radius--tl" data-radius-handle="tl"></span>
        <span class="radius radius--tr" data-radius-handle="tr"></span>
        <span class="radius radius--br" data-radius-handle="br"></span>
        <span class="radius radius--bl" data-radius-handle="bl"></span>
        <span class="size" aria-hidden="true">118 × 145</span>
    </div>
</figure>

<script>
    const box = document.querySelector<HTMLElement>("[data-figma-box]");
    const frame = box?.querySelector<HTMLElement>(".frame");
    const sizeLabel = box?.querySelector<HTMLElement>(".size");
    const resizeHandles =
        box?.querySelectorAll<HTMLElement>("[data-resize-handle]") ?? [];
    const radiusHandles =
        box?.querySelectorAll<HTMLElement>("[data-radius-handle]") ?? [];
    const minSize = 60;

    type FrameState = {
        x: number;
        y: number;
        width: number;
        height: number;
    };

    type PointerState = {
        pointerId: number;
        startX: number;
        startY: number;
    };

    type DragState = PointerState & {
        originX: number;
        originY: number;
    };

    type ResizeState = PointerState &
        FrameState & {
            handle: string;
            aspectRatio: number;
        };

    type RadiusState = PointerState & {
        handle: string;
        originRadius: number;
    };

    let dragState: DragState | undefined;
    let resizeState: ResizeState | undefined;
    let radiusState: RadiusState | undefined;

    const getFrameState = (): FrameState => ({
        x: Number(box?.dataset.x ?? 0),
        y: Number(box?.dataset.y ?? 0),
        width: Number(box?.dataset.width ?? frame?.offsetWidth ?? 0),
        height: Number(box?.dataset.height ?? frame?.offsetHeight ?? 0),
    });

    const setFrameState = ({ x, y, width, height }: FrameState) => {
        if (!box) {
            return;
        }

        box.dataset.x = String(x);
        box.dataset.y = String(y);
        box.dataset.width = String(width);
        box.dataset.height = String(height);
        box.style.setProperty("--box-x", `${x}px`);
        box.style.setProperty("--box-y", `${y}px`);
        box.style.setProperty("--box-width", `${width}px`);
        box.style.setProperty("--box-height", `${height}px`);

        if (sizeLabel) {
            sizeLabel.textContent = `${Math.round(width)} × ${Math.round(
                height,
            )}`;
        }

        if (box.dataset.radius) {
            setRadius(getRadius());
        }
    };

    const getRadius = () => Number(box?.dataset.radius ?? 0);

    const setRadius = (radius: number) => {
        if (!box) {
            return;
        }

        const frameState = getFrameState();
        const maxRadius = Math.min(frameState.width, frameState.height) / 2;
        const nextRadius = Math.max(0, Math.min(maxRadius, radius));

        box.dataset.radius = String(nextRadius);
        box.style.setProperty("--box-radius", `${nextRadius}px`);
    };

    const selectBox = () => {
        if (!box) {
            return;
        }

        box.dataset.selected = "true";
        box.focus();
    };

    const resizeRadius = (event: PointerEvent) => {
        if (!radiusState || event.pointerId !== radiusState.pointerId) {
            return;
        }

        const deltaX = event.clientX - radiusState.startX;
        const deltaY = event.clientY - radiusState.startY;
        const affectsLeft = radiusState.handle.includes("l");
        const affectsTop = radiusState.handle.includes("t");
        const xRadius =
            radiusState.originRadius + (affectsLeft ? deltaX : -deltaX);
        const yRadius =
            radiusState.originRadius + (affectsTop ? deltaY : -deltaY);

        setRadius(Math.max(xRadius, yRadius));
    };

    const resizeFrame = (event: PointerEvent) => {
        if (!resizeState || event.pointerId !== resizeState.pointerId) {
            return;
        }

        const deltaX = event.clientX - resizeState.startX;
        const deltaY = event.clientY - resizeState.startY;
        const affectsLeft = resizeState.handle.includes("l");
        const affectsTop = resizeState.handle.includes("t");
        const affectsRight = resizeState.handle.includes("r");
        const affectsBottom = resizeState.handle.includes("b");
        const affectsWidth = affectsLeft || affectsRight;
        const affectsHeight = affectsTop || affectsBottom;
        let width = affectsWidth
            ? resizeState.width + (affectsLeft ? -deltaX : deltaX)
            : resizeState.width;
        let height = affectsHeight
            ? resizeState.height + (affectsTop ? -deltaY : deltaY)
            : resizeState.height;

        width = Math.max(minSize, width);
        height = Math.max(minSize, height);

        if (event.shiftKey && affectsWidth && affectsHeight) {
            const widthFromHeight = height * resizeState.aspectRatio;
            const heightFromWidth = width / resizeState.aspectRatio;
            const movedMoreHorizontally =
                Math.abs(width - resizeState.width) >
                Math.abs(height - resizeState.height);

            if (movedMoreHorizontally) {
                height = Math.max(minSize, heightFromWidth);
            } else {
                width = Math.max(minSize, widthFromHeight);
            }
        } else if (event.shiftKey && affectsWidth) {
            height = Math.max(minSize, width / resizeState.aspectRatio);
        } else if (event.shiftKey && affectsHeight) {
            width = Math.max(minSize, height * resizeState.aspectRatio);
        }

        const x = affectsLeft
            ? resizeState.x + resizeState.width - width
            : resizeState.x;
        const y = affectsTop
            ? resizeState.y + resizeState.height - height
            : resizeState.y;

        setFrameState({ x, y, width, height });
    };

    const initializeSize = () => {
        const frameState = getFrameState();
        setFrameState(frameState);

        const initialRadius = frame
            ? Number.parseFloat(getComputedStyle(frame).borderTopLeftRadius)
            : 0;
        setRadius(initialRadius);
    };

    frame?.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) {
            return;
        }

        if ((event.target as HTMLElement).closest("[data-resize-handle]")) {
            return;
        }

        if ((event.target as HTMLElement).closest("[data-radius-handle]")) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        selectBox();

        const frameState = getFrameState();
        dragState = {
            pointerId: event.pointerId,
            startX: event.clientX,
            startY: event.clientY,
            originX: frameState.x,
            originY: frameState.y,
        };

        frame.setPointerCapture(event.pointerId);
        box?.setAttribute("data-dragging", "true");
    });

    frame?.addEventListener("pointermove", (event) => {
        if (!dragState || event.pointerId !== dragState.pointerId) {
            return;
        }

        const frameState = getFrameState();
        setFrameState({
            ...frameState,
            x: dragState.originX + event.clientX - dragState.startX,
            y: dragState.originY + event.clientY - dragState.startY,
        });
    });

    const endDrag = (event: PointerEvent) => {
        if (!dragState || event.pointerId !== dragState.pointerId) {
            return;
        }

        if (frame?.hasPointerCapture(event.pointerId)) {
            frame.releasePointerCapture(event.pointerId);
        }

        box?.removeAttribute("data-dragging");
        dragState = undefined;
    };

    frame?.addEventListener("pointerup", endDrag);
    frame?.addEventListener("pointercancel", endDrag);

    resizeHandles.forEach((handle) => {
        handle.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();
            selectBox();

            const frameState = getFrameState();
            resizeState = {
                ...frameState,
                pointerId: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                handle: handle.dataset.resizeHandle ?? "br",
                aspectRatio: frameState.width / frameState.height,
            };

            handle.setPointerCapture(event.pointerId);
            box?.setAttribute("data-resizing", "true");
        });

        handle.addEventListener("pointermove", resizeFrame);

        const endResize = (event: PointerEvent) => {
            if (!resizeState || event.pointerId !== resizeState.pointerId) {
                return;
            }

            if (handle.hasPointerCapture(event.pointerId)) {
                handle.releasePointerCapture(event.pointerId);
            }

            box?.removeAttribute("data-resizing");
            resizeState = undefined;
        };

        handle.addEventListener("pointerup", endResize);
        handle.addEventListener("pointercancel", endResize);
    });

    radiusHandles.forEach((handle) => {
        handle.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();
            selectBox();

            radiusState = {
                pointerId: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                handle: handle.dataset.radiusHandle ?? "tl",
                originRadius: getRadius(),
            };

            handle.setPointerCapture(event.pointerId);
            box?.setAttribute("data-rounding", "true");
        });

        handle.addEventListener("pointermove", resizeRadius);

        const endRadius = (event: PointerEvent) => {
            if (!radiusState || event.pointerId !== radiusState.pointerId) {
                return;
            }

            if (handle.hasPointerCapture(event.pointerId)) {
                handle.releasePointerCapture(event.pointerId);
            }

            box?.removeAttribute("data-rounding");
            radiusState = undefined;
        };

        handle.addEventListener("pointerup", endRadius);
        handle.addEventListener("pointercancel", endRadius);
    });

    box?.addEventListener("click", (event) => {
        event.stopPropagation();
        selectBox();
    });

    box?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            box.removeAttribute("data-selected");
            box.blur();
        }
    });

    document.addEventListener("click", () => {
        box?.removeAttribute("data-selected");
    });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeSize, {
            once: true,
        });
    } else {
        initializeSize();
    }
</script>

<style>
    .box {
        width: var(--figma-box-width, 118px);
        height: var(--figma-box-height, 145px);
        margin: 0 0 8px;
        overflow: visible;
        cursor: default;
        touch-action: none;
        --box-x: 0px;
        --box-y: 0px;
        --box-width: 100%;
        --box-height: 100%;
        --box-radius: var(--radius);
        --radius-handle-offset: max(17px, var(--box-radius));
        --selection-color: #0d99ff;
    }

    .box:focus {
        outline: none;
    }

    .frame {
        position: relative;
        width: var(--box-width);
        height: var(--box-height);
        border-radius: var(--box-radius);
        background: var(--card);
        transform: translate3d(var(--box-x), var(--box-y), 0);
        will-change: transform;
        user-select: none;
    }

    .frame::before {
        position: absolute;
        inset: -1px;
        z-index: 2;
        pointer-events: none;
        content: "";
        border: 1px solid var(--selection-color);
        border-radius: 0;
        opacity: 0;
    }

    .content {
        width: 100%;
        height: 100%;
    }

    .content > :global(*) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--box-radius);
    }

    .edge,
    .corner,
    .radius {
        position: absolute;
        z-index: 3;
    }

    .edge {
        opacity: 0;
    }

    .edge--top,
    .edge--bottom {
        left: 9px;
        width: calc(100% - 18px);
        height: 12px;
        transform: translateY(-50%);
    }

    .edge--top {
        top: 0;
    }

    .edge--bottom {
        top: 100%;
    }

    .edge--right,
    .edge--left {
        top: 9px;
        width: 12px;
        height: calc(100% - 18px);
        transform: translateX(-50%);
    }

    .edge--right {
        left: 100%;
    }

    .edge--left {
        left: 0;
    }

    .corner,
    .radius {
        width: 9px;
        height: 9px;
        border: 2px solid var(--selection-color);
        background: #fff;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .radius {
        border-radius: 999px;
    }

    .corner--tl {
        top: 0;
        left: 0;
    }

    .corner--tr {
        top: 0;
        left: 100%;
    }

    .corner--br {
        top: 100%;
        left: 100%;
    }

    .corner--bl {
        top: 100%;
        left: 0;
    }

    .radius--tl {
        top: var(--radius-handle-offset);
        left: var(--radius-handle-offset);
    }

    .radius--tr {
        top: var(--radius-handle-offset);
        left: calc(100% - var(--radius-handle-offset));
    }

    .radius--br {
        top: calc(100% - var(--radius-handle-offset));
        left: calc(100% - var(--radius-handle-offset));
    }

    .radius--bl {
        top: calc(100% - var(--radius-handle-offset));
        left: var(--radius-handle-offset);
    }

    .size {
        position: absolute;
        z-index: 4;
        padding: 1px 6px 2px;
        border-radius: 3px;
        color: #fff;
        background: var(--selection-color);
        font-size: 10px;
        line-height: 1.2;
        font-weight: 700;
        white-space: nowrap;
        transform: translateX(-50%);
        user-select: none;
        opacity: 0;
    }

    .size {
        top: calc(100% + 13px);
        left: 50%;
        transform: translateX(-50%);
    }

    .box:hover .frame::before,
    .box[data-selected="true"] .frame::before,
    .box[data-selected="true"] .corner,
    .box[data-selected="true"] .radius,
    .box[data-selected="true"] .size {
        opacity: 1;
    }

    .box[data-dragging="true"] .frame::before,
    .box[data-dragging="true"] .corner,
    .box[data-dragging="true"] .radius,
    .box[data-dragging="true"] .size {
        opacity: 0;
    }

    @media (max-width: 720px) {
        .box {
            width: var(--figma-box-mobile-width, 96px);
            height: var(--figma-box-mobile-height, 118px);
        }

        .size {
            font-size: 10px;
        }
    }
</style>
