<figure
    class="figma-portrait"
    data-figma-portrait
    tabindex="0"
    aria-label="Portrait frame"
>
    <div class="figma-portrait__frame">
        <img
            src="/bugra-aydingoz-portrait.jpeg"
            width="236"
            height="236"
            alt="Buğra Aydıngöz portrait"
        />
        <span class="figma-portrait__corner figma-portrait__corner--tl"></span>
        <span class="figma-portrait__corner figma-portrait__corner--tr"></span>
        <span class="figma-portrait__corner figma-portrait__corner--br"></span>
        <span class="figma-portrait__corner figma-portrait__corner--bl"></span>
        <span class="figma-portrait__radius figma-portrait__radius--tl"></span>
        <span class="figma-portrait__radius figma-portrait__radius--tr"></span>
        <span class="figma-portrait__radius figma-portrait__radius--br"></span>
        <span class="figma-portrait__radius figma-portrait__radius--bl"></span>
        <span class="figma-portrait__size" aria-hidden="true">118 × 145</span>
    </div>
</figure>

<script>
    const portraits = document.querySelectorAll<HTMLElement>(
        "[data-figma-portrait]",
    );

    portraits.forEach((portrait) => {
        const frame = portrait.querySelector<HTMLElement>(
            ".figma-portrait__frame",
        );
        let dragState:
            | {
                  pointerId: number;
                  startX: number;
                  startY: number;
                  originX: number;
                  originY: number;
              }
            | undefined;

        const selectPortrait = () => {
            portraits.forEach((item) => {
                item.dataset.selected = String(item === portrait);
            });
            portrait.focus();
        };

        frame?.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();
            selectPortrait();

            dragState = {
                pointerId: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                originX: Number(portrait.dataset.x ?? 0),
                originY: Number(portrait.dataset.y ?? 0),
            };

            frame.setPointerCapture(event.pointerId);
            portrait.dataset.dragging = "true";
        });

        frame?.addEventListener("pointermove", (event) => {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }

            const nextX = dragState.originX + event.clientX - dragState.startX;
            const nextY = dragState.originY + event.clientY - dragState.startY;

            portrait.dataset.x = String(nextX);
            portrait.dataset.y = String(nextY);
            portrait.style.setProperty("--portrait-x", `${nextX}px`);
            portrait.style.setProperty("--portrait-y", `${nextY}px`);
        });

        const endDrag = (event: PointerEvent) => {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }

            if (frame?.hasPointerCapture(event.pointerId)) {
                frame.releasePointerCapture(event.pointerId);
            }

            delete portrait.dataset.dragging;
            dragState = undefined;
        };

        frame?.addEventListener("pointerup", endDrag);
        frame?.addEventListener("pointercancel", endDrag);

        portrait.addEventListener("click", (event) => {
            event.stopPropagation();
            selectPortrait();
        });

        portrait.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                delete portrait.dataset.selected;
                portrait.blur();
            }
        });
    });

    document.addEventListener("click", () => {
        portraits.forEach((portrait) => {
            delete portrait.dataset.selected;
        });
    });
</script>

<style>
    .figma-portrait {
        width: 118px;
        height: 145px;
        margin: 0 0 8px;
        overflow: visible;
        cursor: default;
        touch-action: none;
        --portrait-x: 0px;
        --portrait-y: 0px;
        --selection-color: #0d99ff;
    }

    .figma-portrait:focus {
        outline: none;
    }

    .figma-portrait__frame {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: var(--radius);
        background: var(--card);
        transform: translate3d(var(--portrait-x), var(--portrait-y), 0);
        will-change: transform;
        user-select: none;
    }

    .figma-portrait__frame::before {
        position: absolute;
        inset: -1px;
        z-index: 2;
        pointer-events: none;
        content: "";
        border: 1px solid var(--selection-color);
        border-radius: 0;
        opacity: 0;
    }

    .figma-portrait img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--radius);
    }

    .figma-portrait__corner {
        position: absolute;
        z-index: 3;
        width: 9px;
        height: 9px;
        border: 2px solid var(--selection-color);
        background: #fff;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .figma-portrait__radius {
        position: absolute;
        z-index: 3;
        width: 9px;
        height: 9px;
        border: 2px solid var(--selection-color);
        border-radius: 999px;
        background: #fff;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .figma-portrait__corner--tl {
        top: 0;
        left: 0;
    }

    .figma-portrait__corner--tr {
        top: 0;
        left: 100%;
    }

    .figma-portrait__corner--br {
        top: 100%;
        left: 100%;
    }

    .figma-portrait__corner--bl {
        top: 100%;
        left: 0;
    }

    .figma-portrait__radius--tl {
        top: 17px;
        left: 17px;
    }

    .figma-portrait__radius--tr {
        top: 17px;
        left: calc(100% - 17px);
    }

    .figma-portrait__radius--br {
        top: calc(100% - 17px);
        left: calc(100% - 17px);
    }

    .figma-portrait__radius--bl {
        top: calc(100% - 17px);
        left: 17px;
    }

    .figma-portrait__size {
        position: absolute;
        top: calc(100% + 13px);
        left: 50%;
        z-index: 4;
        padding: 1px 6px 2px;
        border-radius: 3px;
        color: #fff;
        background: var(--selection-color);
        font-size: 10px;
        line-height: 1.2;
        font-weight: 700;
        white-space: nowrap;
        transform: translateX(-50%);
        user-select: none;
        opacity: 0;
    }

    .figma-portrait:hover .figma-portrait__frame::before,
    .figma-portrait[data-selected="true"] .figma-portrait__frame::before,
    .figma-portrait[data-selected="true"] .figma-portrait__corner,
    .figma-portrait[data-selected="true"] .figma-portrait__radius,
    .figma-portrait[data-selected="true"] .figma-portrait__size {
        opacity: 1;
    }

    .figma-portrait[data-dragging="true"] .figma-portrait__frame::before,
    .figma-portrait[data-dragging="true"] .figma-portrait__corner,
    .figma-portrait[data-dragging="true"] .figma-portrait__radius,
    .figma-portrait[data-dragging="true"] .figma-portrait__size {
        opacity: 0;
    }

    @media (max-width: 720px) {
        .figma-portrait {
            width: 96px;
            height: 118px;
        }

        .figma-portrait__size {
            font-size: 10px;
        }
    }
</style>
