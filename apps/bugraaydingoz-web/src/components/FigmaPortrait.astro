<figure
    class="figma-portrait"
    data-figma-portrait
    tabindex="0"
    aria-label="Portrait frame"
>
    <div class="figma-portrait__frame">
        <img
            src="/bugra-aydingoz-portrait.jpeg"
            width="236"
            height="236"
            alt="Buğra Aydıngöz portrait"
        />
        <span
            class="figma-portrait__corner figma-portrait__corner--tl"
            data-resize-handle="tl"
        ></span>
        <span
            class="figma-portrait__corner figma-portrait__corner--tr"
            data-resize-handle="tr"
        ></span>
        <span
            class="figma-portrait__corner figma-portrait__corner--br"
            data-resize-handle="br"
        ></span>
        <span
            class="figma-portrait__corner figma-portrait__corner--bl"
            data-resize-handle="bl"
        ></span>
        <span class="figma-portrait__radius figma-portrait__radius--tl"></span>
        <span class="figma-portrait__radius figma-portrait__radius--tr"></span>
        <span class="figma-portrait__radius figma-portrait__radius--br"></span>
        <span class="figma-portrait__radius figma-portrait__radius--bl"></span>
        <span class="figma-portrait__size" aria-hidden="true">118 × 145</span>
    </div>
</figure>

<script>
    const portraits = document.querySelectorAll<HTMLElement>(
        "[data-figma-portrait]",
    );
    const minSize = 60;

    type FrameState = {
        x: number;
        y: number;
        width: number;
        height: number;
    };

    type PointerState = {
        pointerId: number;
        startX: number;
        startY: number;
    };

    type DragState = PointerState & {
        originX: number;
        originY: number;
    };

    type ResizeState = PointerState &
        FrameState & {
            handle: string;
            aspectRatio: number;
    };

    portraits.forEach((portrait) => {
        const frame = portrait.querySelector<HTMLElement>(
            ".figma-portrait__frame",
        );
        const sizeLabel = portrait.querySelector<HTMLElement>(
            ".figma-portrait__size",
        );
        const resizeHandles =
            portrait.querySelectorAll<HTMLElement>("[data-resize-handle]");
        let dragState: DragState | undefined;
        let resizeState: ResizeState | undefined;

        const getFrameState = (): FrameState => ({
            x: Number(portrait.dataset.x ?? 0),
            y: Number(portrait.dataset.y ?? 0),
            width: Number(portrait.dataset.width ?? frame?.offsetWidth ?? 0),
            height: Number(portrait.dataset.height ?? frame?.offsetHeight ?? 0),
        });

        const setFrameState = ({ x, y, width, height }: FrameState) => {
            portrait.dataset.x = String(x);
            portrait.dataset.y = String(y);
            portrait.dataset.width = String(width);
            portrait.dataset.height = String(height);
            portrait.style.setProperty("--portrait-x", `${x}px`);
            portrait.style.setProperty("--portrait-y", `${y}px`);
            portrait.style.setProperty("--portrait-width", `${width}px`);
            portrait.style.setProperty("--portrait-height", `${height}px`);

            if (sizeLabel) {
                sizeLabel.textContent = `${Math.round(width)} × ${Math.round(
                    height,
                )}`;
            }
        };

        const selectPortrait = () => {
            portraits.forEach((item) => {
                item.dataset.selected = String(item === portrait);
            });
            portrait.focus();
        };

        const resizeFrame = (event: PointerEvent) => {
            if (!resizeState || event.pointerId !== resizeState.pointerId) {
                return;
            }

            const deltaX = event.clientX - resizeState.startX;
            const deltaY = event.clientY - resizeState.startY;
            const affectsLeft = resizeState.handle.includes("l");
            const affectsTop = resizeState.handle.includes("t");
            let width = resizeState.width + (affectsLeft ? -deltaX : deltaX);
            let height = resizeState.height + (affectsTop ? -deltaY : deltaY);

            width = Math.max(minSize, width);
            height = Math.max(minSize, height);

            if (event.shiftKey) {
                const widthFromHeight = height * resizeState.aspectRatio;
                const heightFromWidth = width / resizeState.aspectRatio;
                const movedMoreHorizontally =
                    Math.abs(width - resizeState.width) >
                    Math.abs(height - resizeState.height);

                if (movedMoreHorizontally) {
                    height = Math.max(minSize, heightFromWidth);
                } else {
                    width = Math.max(minSize, widthFromHeight);
                }
            }

            const x = affectsLeft
                ? resizeState.x + resizeState.width - width
                : resizeState.x;
            const y = affectsTop
                ? resizeState.y + resizeState.height - height
                : resizeState.y;

            setFrameState({ x, y, width, height });
        };

        frame?.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) {
                return;
            }

            if ((event.target as HTMLElement).closest("[data-resize-handle]")) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();
            selectPortrait();

            const frameState = getFrameState();
            dragState = {
                pointerId: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                originX: frameState.x,
                originY: frameState.y,
            };

            frame.setPointerCapture(event.pointerId);
            portrait.dataset.dragging = "true";
        });

        frame?.addEventListener("pointermove", (event) => {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }

            const frameState = getFrameState();
            setFrameState({
                ...frameState,
                x: dragState.originX + event.clientX - dragState.startX,
                y: dragState.originY + event.clientY - dragState.startY,
            });
        });

        const endDrag = (event: PointerEvent) => {
            if (!dragState || event.pointerId !== dragState.pointerId) {
                return;
            }

            if (frame?.hasPointerCapture(event.pointerId)) {
                frame.releasePointerCapture(event.pointerId);
            }

            delete portrait.dataset.dragging;
            dragState = undefined;
        };

        frame?.addEventListener("pointerup", endDrag);
        frame?.addEventListener("pointercancel", endDrag);

        resizeHandles.forEach((handle) => {
            handle.addEventListener("pointerdown", (event) => {
                if (event.button !== 0) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                selectPortrait();

                const frameState = getFrameState();
                resizeState = {
                    ...frameState,
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    handle: handle.dataset.resizeHandle ?? "br",
                    aspectRatio: frameState.width / frameState.height,
                };

                handle.setPointerCapture(event.pointerId);
                portrait.dataset.resizing = "true";
            });

            handle.addEventListener("pointermove", resizeFrame);

            const endResize = (event: PointerEvent) => {
                if (
                    !resizeState ||
                    event.pointerId !== resizeState.pointerId
                ) {
                    return;
                }

                if (handle.hasPointerCapture(event.pointerId)) {
                    handle.releasePointerCapture(event.pointerId);
                }

                delete portrait.dataset.resizing;
                resizeState = undefined;
            };

            handle.addEventListener("pointerup", endResize);
            handle.addEventListener("pointercancel", endResize);
        });

        portrait.addEventListener("click", (event) => {
            event.stopPropagation();
            selectPortrait();
        });

        portrait.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                delete portrait.dataset.selected;
                portrait.blur();
            }
        });
    });

    document.addEventListener("click", () => {
        portraits.forEach((portrait) => {
            delete portrait.dataset.selected;
        });
    });
</script>

<style>
    .figma-portrait {
        width: 118px;
        height: 145px;
        margin: 0 0 8px;
        overflow: visible;
        cursor: default;
        touch-action: none;
        --portrait-x: 0px;
        --portrait-y: 0px;
        --portrait-width: 100%;
        --portrait-height: 100%;
        --selection-color: #0d99ff;
    }

    .figma-portrait:focus {
        outline: none;
    }

    .figma-portrait__frame {
        position: relative;
        width: var(--portrait-width);
        height: var(--portrait-height);
        border-radius: var(--radius);
        background: var(--card);
        transform: translate3d(var(--portrait-x), var(--portrait-y), 0);
        will-change: transform;
        user-select: none;
    }

    .figma-portrait__frame::before {
        position: absolute;
        inset: -1px;
        z-index: 2;
        pointer-events: none;
        content: "";
        border: 1px solid var(--selection-color);
        border-radius: 0;
        opacity: 0;
    }

    .figma-portrait img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--radius);
    }

    .figma-portrait__corner {
        position: absolute;
        z-index: 3;
        width: 9px;
        height: 9px;
        border: 2px solid var(--selection-color);
        background: #fff;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .figma-portrait__radius {
        position: absolute;
        z-index: 3;
        width: 9px;
        height: 9px;
        border: 2px solid var(--selection-color);
        border-radius: 999px;
        background: #fff;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .figma-portrait__corner--tl {
        top: 0;
        left: 0;
    }

    .figma-portrait__corner--tr {
        top: 0;
        left: 100%;
    }

    .figma-portrait__corner--br {
        top: 100%;
        left: 100%;
    }

    .figma-portrait__corner--bl {
        top: 100%;
        left: 0;
    }

    .figma-portrait__radius--tl {
        top: 17px;
        left: 17px;
    }

    .figma-portrait__radius--tr {
        top: 17px;
        left: calc(100% - 17px);
    }

    .figma-portrait__radius--br {
        top: calc(100% - 17px);
        left: calc(100% - 17px);
    }

    .figma-portrait__radius--bl {
        top: calc(100% - 17px);
        left: 17px;
    }

    .figma-portrait__size {
        position: absolute;
        top: calc(100% + 13px);
        left: 50%;
        z-index: 4;
        padding: 1px 6px 2px;
        border-radius: 3px;
        color: #fff;
        background: var(--selection-color);
        font-size: 10px;
        line-height: 1.2;
        font-weight: 700;
        white-space: nowrap;
        transform: translateX(-50%);
        user-select: none;
        opacity: 0;
    }

    .figma-portrait:hover .figma-portrait__frame::before,
    .figma-portrait[data-selected="true"] .figma-portrait__frame::before,
    .figma-portrait[data-selected="true"] .figma-portrait__corner,
    .figma-portrait[data-selected="true"] .figma-portrait__radius,
    .figma-portrait[data-selected="true"] .figma-portrait__size {
        opacity: 1;
    }

    .figma-portrait[data-dragging="true"] .figma-portrait__frame::before,
    .figma-portrait[data-dragging="true"] .figma-portrait__corner,
    .figma-portrait[data-dragging="true"] .figma-portrait__radius,
    .figma-portrait[data-dragging="true"] .figma-portrait__size {
        opacity: 0;
    }

    @media (max-width: 720px) {
        .figma-portrait {
            width: 96px;
            height: 118px;
        }

        .figma-portrait__size {
            font-size: 10px;
        }
    }
</style>
