---
type Props = {
    description?: string;
    headline?: string;
    image?: string;
    imageAlt?: string;
    noindex?: boolean;
    publishedDate?: Date | string;
    tags?: string[];
    title?: string;
    type?: "article" | "profile" | "website";
    updatedDate?: Date | string;
};

const siteUrl = "https://bugraaydingoz.com";
const defaultTitle = "Buğra Aydıngöz";
const defaultDescription =
    "Product Engineer with 8+ years of experience creating intuitive, user-focused applications. Strong expertise in frontend development and design, complemented by backend skills and leading teams.";

const {
    description = defaultDescription,
    headline,
    image = "/og-image.png",
    imageAlt,
    noindex = false,
    publishedDate,
    tags = [
        "Product Engineering",
        "Frontend Development",
        "TypeScript",
        "React",
        "Figma",
        "Node.js",
        "Go",
        "MySQL",
    ],
    title = defaultTitle,
    type = "website",
    updatedDate,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const robots = noindex ? "noindex, nofollow" : "index, follow";
const faviconVersion = "20260617";
function formatDate(value: Date | string | undefined) {
    if (!value) {
        return undefined;
    }

    if (value instanceof Date) {
        return value.toISOString().slice(0, 10);
    }

    return value;
}

const formattedPublishedDate = formatDate(publishedDate);
const formattedUpdatedDate = formatDate(updatedDate) ?? formattedPublishedDate;
const structuredHeadline = headline ?? title;
const socialImageAlt =
    imageAlt ??
    (type === "article"
        ? `${structuredHeadline} by Buğra Aydıngöz.`
        : "Buğra Aydıngöz, Product Engineer, with a portrait and introduction.");
const personStructuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: defaultTitle,
    jobTitle: "Product Engineer",
    url: siteUrl,
    image: new URL("/bugra-aydingoz-portrait.jpeg", siteUrl).href,
    email: "hello@bugraaydingoz.com",
    sameAs: [
        "https://www.linkedin.com/in/bugraaydingoz/",
        "https://x.com/bugraaydingoz",
        "https://github.com/bugraaydingoz",
    ],
    knowsAbout: tags,
};
const articleStructuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: structuredHeadline,
    description,
    image: imageUrl,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    datePublished: formattedPublishedDate,
    dateModified: formattedUpdatedDate,
    keywords: tags,
    author: {
        "@type": "Person",
        name: defaultTitle,
        url: siteUrl,
    },
    publisher: {
        "@type": "Person",
        name: defaultTitle,
        url: siteUrl,
    },
};
const structuredData = JSON.stringify(
    type === "article" ? articleStructuredData : personStructuredData,
);
const keywords = ["Buğra Aydıngöz", ...tags].join(", ");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="canonical" href={canonicalUrl} />
        <link
            rel="icon"
            type="image/x-icon"
            href={`/favicon.ico?v=${faviconVersion}`}
            sizes="any"
        />
        <link
            rel="shortcut icon"
            href={`/favicon.ico?v=${faviconVersion}`}
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href={`/favicon-32x32.png?v=${faviconVersion}`}
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href={`/favicon-16x16.png?v=${faviconVersion}`}
        />
        <link
            rel="apple-touch-icon"
            href={`/apple-touch-icon.png?v=${faviconVersion}`}
        />
        <link rel="manifest" href={`/site.webmanifest?v=${faviconVersion}`} />
        <link
            rel="preload"
            href="/fonts/satoshi-regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/satoshi-medium.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/satoshi-bold.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="author" content="Buğra Aydıngöz" />
        <meta name="creator" content="Buğra Aydıngöz" />
        <meta name="publisher" content="Buğra Aydıngöz" />
        <meta name="robots" content={robots} />
        <meta name="keywords" content={keywords} />
        <meta name="theme-color" content="#111111" />
        <meta name="color-scheme" content="dark" />
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content="Buğra Aydıngöz" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:secure_url" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialImageAlt} />
        <meta property="og:locale" content="en_US" />
        {
            type === "article" && formattedPublishedDate && (
                <meta
                    property="article:published_time"
                    content={formattedPublishedDate}
                />
            )
        }
        {
            type === "article" && formattedUpdatedDate && (
                <meta
                    property="article:modified_time"
                    content={formattedUpdatedDate}
                />
            )
        }
        {
            type === "article" && (
                <meta property="article:author" content={defaultTitle} />
            )
        }
        {
            type === "article" &&
                tags.map((tag) => <meta property="article:tag" content={tag} />)
        }
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@bugraaydingoz" />
        <meta name="twitter:creator" content="@bugraaydingoz" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={socialImageAlt} />
        <script type="application/ld+json" set:html={structuredData} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-regular.woff2") format("woff2");
        font-display: block;
        font-style: normal;
        font-weight: 400;
    }

    @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-medium.woff2") format("woff2");
        font-display: block;
        font-style: normal;
        font-weight: 500;
    }

    @font-face {
        font-family: "Satoshi";
        src: url("/fonts/satoshi-bold.woff2") format("woff2");
        font-display: block;
        font-style: normal;
        font-weight: 700;
    }

    :root {
        --background: oklch(0.145 0 0);
        --foreground: oklch(0.985 0 0);
        --card: oklch(0.205 0 0);
        --card-foreground: oklch(0.985 0 0);
        --popover: oklch(0.205 0 0);
        --popover-foreground: oklch(0.985 0 0);
        --primary: oklch(0.922 0 0);
        --primary-foreground: oklch(0.205 0 0);
        --secondary: oklch(0.269 0 0);
        --secondary-foreground: oklch(0.985 0 0);
        --muted: oklch(0.269 0 0);
        --muted-foreground: oklch(0.708 0 0);
        --accent: oklch(0.269 0 0);
        --accent-foreground: oklch(0.985 0 0);
        --destructive: oklch(0.704 0.191 22.216);
        --border: oklch(1 0 0 / 10%);
        --input: oklch(1 0 0 / 15%);
        --ring: oklch(0.556 0 0);
        --chart-1: oklch(0.87 0 0);
        --chart-2: oklch(0.556 0 0);
        --chart-3: oklch(0.439 0 0);
        --chart-4: oklch(0.371 0 0);
        --chart-5: oklch(0.269 0 0);
        --radius: 0.625rem;
        --sidebar: oklch(0.205 0 0);
        --sidebar-foreground: oklch(0.985 0 0);
        --sidebar-primary: oklch(0.488 0.243 264.376);
        --sidebar-primary-foreground: oklch(0.985 0 0);
        --sidebar-accent: oklch(0.269 0 0);
        --sidebar-accent-foreground: oklch(0.985 0 0);
        --sidebar-border: oklch(1 0 0 / 10%);
        --sidebar-ring: oklch(0.556 0 0);
    }

    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        color: var(--foreground);
        background: var(--background);
        font-family:
            "Satoshi", Inter, "Inter Variable", Roboto, "Helvetica Neue", Arial,
            sans-serif;
        font-weight: 400;
    }
</style>
