        <meta
            name="description"
            content="Buğra Aydıngöz is a senior software engineer and product engineer focused on intuitive, user-focused applications."
        />
        <title>Buğra Aydıngöz | Sr. Software Engineer</title>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const systemQuery = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                );

                const applyTheme = () => {
                    const theme = systemQuery.matches ? "dark" : "light";
                    root.classList.toggle("dark", theme === "dark");
                    root.dataset.theme = theme;
                    root.style.colorScheme = theme;
                };

                applyTheme();
                systemQuery.addEventListener("change", applyTheme);
            })();
        </script>
    </head>
    <body>
        <slot />
    </body>
</html>

