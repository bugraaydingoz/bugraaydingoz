# Copy to .env.local for host-based development.
# Match PGPASSWORD to POSTGRES_PASSWORD in the repository's .env.local.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/robofleet
PGPASSWORD=

# Password is read from REDIS_PASSWORD in the root .env.local.
REDIS_URL=redis://127.0.0.1:6379/0
SIMULATOR_ENABLED=true
