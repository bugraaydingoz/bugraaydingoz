{
  "name": "robofleet-api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "check": "tsc --noEmit",
    "migrate": "drizzle-kit generate:pg"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^0.16.0",
    "@hono/zod-validator": "0.3.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.8",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.24.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
