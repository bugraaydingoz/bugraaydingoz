{
  "name": "robofleet-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "check": "tsc --noEmit",
    "test:unit": "vitest",
    "test": "pnpm test:unit --run && pnpm test:e2e",
    "test:e2e": "playwright install chromium && playwright test",
    "lint:fix": "oxlint --config ../../.oxlintrc.json . --fix",
    "format": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.gitignore --ignore-path ../../.oxfmtignore --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --ignore-path ../../.gitignore --ignore-path ../../.oxfmtignore --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@repo/design-tokens": "workspace:*",
    "@tanstack/react-query": "^5.51.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.5.8",
    "lucide-react": "^1.61.0",
    "nuqs": "2.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
