    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^25.9.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/browser-playwright": "^4.1.3",
    "bits-ui": "^2.18.1",
    "playwright": "^1.60.0",
    "svelte": "^5.55.2",
